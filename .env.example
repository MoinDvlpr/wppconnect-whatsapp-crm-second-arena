# ---- Database (Supabase via Drizzle ORM) ----
# Session-mode pooler connection string from:
# Supabase Dashboard → Project Settings → Database → Connection Pooling → Session mode (port 5432)
SUPABASE_DB_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project credentials from Dashboard → Project Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- WPPConnect ----
# Persistent browser tokens/sessions (must be a Docker volume in production)
WPP_SESSIONS_PATH="./data/wppconnect"
# Optional: path to system Chrome/Chromium. Leave empty to use Puppeteer's bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=""
# Restore autoStart sessions on boot (true/false)
WPP_AUTO_RESTORE="true"
# Keep raw WPPConnect payloads in DB for debugging (heavy, default false)
KEEP_RAW_PAYLOAD="false"

# ---- Media ----
MEDIA_STORAGE_PATH="./data/media"
MEDIA_CACHE="true"
MAX_UPLOAD_MB="64"

# ---- App ----
NEXT_PUBLIC_APP_NAME="WhatsApp CRM"
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
LOG_LEVEL="info"
DEFAULT_TIMEZONE="Asia/Kolkata"
API_RATE_LIMIT="300"
# Set to "false" behind plain-HTTP reverse proxies during testing
COOKIE_SECURE="true"
# Allow webhooks to private/loopback hosts (dev only)
WEBHOOK_ALLOW_PRIVATE="false"
